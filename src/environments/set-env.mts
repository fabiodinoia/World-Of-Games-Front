/**
 * Generates src/environments/environment.ts from environment variables.
 *
 * Runs automatically before `npm start|build|test` (see package.json "pre*"
 * scripts) and can be run on its own with `npm run config`.
 *
 * Values are read from the process environment (CI / hosting provider) and,
 * for local development, from an optional `.env` file at the project root
 * (copy `.env.example`). Real environment variables win over `.env`.
 *
 * Plain Node (>= 22.18 runs .ts natively): keep this file free of non-erasable
 * TypeScript syntax (enums, namespaces, parameter properties).
 */
import { existsSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const here = dirname(fileURLToPath(import.meta.url));
const root = join(here, '..', '..');
const envFile = join(root, '.env');

if (existsSync(envFile)) {
  process.loadEnvFile(envFile);
}

const env = (name: string, fallback = ''): string =>
  (process.env[name] ?? fallback).trim();

const apiUrl = env('API_URL', 'http://localhost:4800').replace(/\/+$/, '');

const environment = {
  production: env('NODE_ENV') === 'production',
  apiUrl,
  firebase: {
    apiKey: env('FIREBASE_API_KEY'),
    authDomain: env('FIREBASE_AUTH_DOMAIN'),
    projectId: env('FIREBASE_PROJECT_ID'),
    storageBucket: env('FIREBASE_STORAGE_BUCKET'),
    messagingSenderId: env('FIREBASE_MESSAGING_SENDER_ID'),
    appId: env('FIREBASE_APP_ID'),
  },
};

const target = join(here, 'environment.ts');
const banner =
  '// AUTO-GENERATED by src/environments/set-env.ts — do not edit or commit.\n' +
  '// Configure values via environment variables or a local .env file.\n';

writeFileSync(
  target,
  `${banner}export const environment = ${JSON.stringify(environment, null, 2)};\n`,
);

const firebaseState = environment.firebase.apiKey
  ? 'configured'
  : 'not configured (image uploads disabled)';
console.log(`[set-env] apiUrl=${apiUrl}; firebase ${firebaseState}`);
