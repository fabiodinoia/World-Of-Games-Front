# Copy to `.env` (git-ignored) for local development, or set these as real
# environment variables in CI / your hosting provider. `npm start`, `npm run
# build` and `npm test` regenerate src/environments/environment.ts from them.

# Base URL of the World of Games API (no trailing slash).
API_URL=http://localhost:4800

# Set to "production" for deployed builds (informational flag in the app).
NODE_ENV=development

# Firebase web config — only needed for image uploads (avatars / game covers).
# Leave blank to run without uploads; users can still paste image URLs.
# Restrict the API key to your domains in the Google Cloud console.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
